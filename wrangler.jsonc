{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webblyftet-finance-test-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webblyftet-finance-test-local",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      "bucket_name": "webblyftet-finance-test-local-receipts"
    }
  ],
  "secrets": {
    "required": [
      "TOKEN_ENCRYPTION_KEY_BASE64",
      "RESEND_API_KEY"
    ]
  },
  "vars": {
    "APP_ENV": "local",
    "APP_BASE_URL": "http://localhost:8787",
    "STRIPE_PUBLISHABLE_KEY": "pk_test_REPLACE_WITH_STRIPE_PUBLISHABLE_KEY",
    "REQUIRE_CLOUDFLARE_ACCESS": "false",
    "CF_ACCESS_TEAM_DOMAIN": "gentle-snowflake-b0da.cloudflareaccess.com",
    "CF_ACCESS_AUD": "645cd3856053b06108fe4a47d3e9bf5e0b2235258836b97ec061ba1fec657aca",
    "MAX_RECEIPT_UPLOAD_BYTES": "10485760",
    "EMAIL_FROM": "offers@REPLACE_WITH_VERIFIED_DOMAIN",
    "EMAIL_FROM_NAME": "Webblyftet",
    "EMAIL_REPLY_TO": "ekonomi@REPLACE_WITH_VERIFIED_DOMAIN",
    "FORTNOX_SCOPES": "companyinformation customer invoice offer order payment supplier supplierinvoice bookkeeping inbox connectfile settings print"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "test": {
      "name": "webblyftet-finance-test",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "webblyftet-finance-test",
          "database_id": "d5af899a-0b40-4c43-b25c-02e128d83104",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "RECEIPTS",
          "bucket_name": "webblyftet-finance-test-receipts"
        }
      ],
      "secrets": {
        "required": [
          "TOKEN_ENCRYPTION_KEY_BASE64",
          "RESEND_API_KEY"
        ]
      },
      "vars": {
        "APP_ENV": "test",
        "APP_BASE_URL": "https://webblyftet-finance-test.webblyftet-finance-test.workers.dev",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_51U6ZmLL9e4dgLD86WH5KUyN7HFU9M5TaCrSTI8yptqPMr7HRNTO3zqStWovaoBcqzSzB6TaRGqpRWLMzcTPcHv8V00tQMP6XKm",
        "REQUIRE_CLOUDFLARE_ACCESS": "true",
        "CF_ACCESS_TEAM_DOMAIN": "gentle-snowflake-b0da.cloudflareaccess.com",
        "CF_ACCESS_AUD": "645cd3856053b06108fe4a47d3e9bf5e0b2235258836b97ec061ba1fec657aca",
        "MAX_RECEIPT_UPLOAD_BYTES": "10485760",
        "EMAIL_FROM": "offers@REPLACE_WITH_VERIFIED_DOMAIN",
        "EMAIL_FROM_NAME": "Webblyftet",
        "EMAIL_REPLY_TO": "ekonomi@REPLACE_WITH_VERIFIED_DOMAIN",
        "FORTNOX_SCOPES": "companyinformation customer invoice offer order payment supplier supplierinvoice bookkeeping inbox connectfile settings print"
      }
    },
    "production": {
      "name": "webblyftet-finance-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "webblyftet-finance-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "RECEIPTS",
          "bucket_name": "webblyftet-finance-production-receipts"
        }
      ],
      "secrets": {
        "required": [
          "TOKEN_ENCRYPTION_KEY_BASE64",
          "RESEND_API_KEY"
        ]
      },
      "vars": {
        "APP_ENV": "production",
        "APP_BASE_URL": "https://DIN-PRODUKTIONSDOMAN",
        "STRIPE_PUBLISHABLE_KEY": "pk_live_REPLACE_WITH_STRIPE_PUBLISHABLE_KEY",
        "REQUIRE_CLOUDFLARE_ACCESS": "true",
        "CF_ACCESS_TEAM_DOMAIN": "REPLACE_WITH_ZERO_TRUST_TEAM.cloudflareaccess.com",
        "CF_ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
        "MAX_RECEIPT_UPLOAD_BYTES": "10485760",
        "EMAIL_FROM": "offers@REPLACE_WITH_VERIFIED_DOMAIN",
        "EMAIL_FROM_NAME": "Webblyftet",
        "EMAIL_REPLY_TO": "ekonomi@REPLACE_WITH_VERIFIED_DOMAIN",
        "FORTNOX_SCOPES": "companyinformation customer invoice offer order payment supplier supplierinvoice bookkeeping inbox connectfile settings print"
      }
    }
  }
}
