{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webblyftet-finance-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/sign/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webblyftet-finance-test",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      "bucket_name": "webblyftet-finance-test-receipts"
    }
  ],
  "vars": {
    "APP_ENV": "test",
    "APP_BASE_URL": "http://localhost:8787",
    "FORTNOX_SCOPES": "companyinformation customer invoice offer order payment supplier supplierinvoice bookkeeping inbox connectfile settings print"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
