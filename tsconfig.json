{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "@cloudflare/vitest-pool-workers/types"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "worker-configuration.d.ts"]
}
